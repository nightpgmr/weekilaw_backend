# ═══════════════════════════════════════════════════════════════════════════
# WEEKILAW BACKEND - ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# To switch between environments, comment/uncomment the appropriate sections

APP_NAME=Weekilaw

# ═══════════════════════════════════════════════════════════════════════════
# ENVIRONMENT SETTINGS
# ═══════════════════════════════════════════════════════════════════════════
# ON SERVER: set APP_ENV=production, APP_DEBUG=false, APP_URL=https://weekilaw.com, OTP_DEV_MODE=false

# --- LOCAL (default) ---
# APP_ENV=local
# APP_DEBUG=true
# APP_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:3000

# --- ON SERVER: uncomment these and comment the LOCAL block above ---
APP_ENV=production
APP_DEBUG=false
APP_URL=https://weekilaw.com
FRONTEND_URL=https://weekilaw.com

# ═══════════════════════════════════════════════════════════════════════════

APP_KEY=base64:teDClOJSgMJm3mqfmXxlRZpS9uwuPRSXd/8F9ul2YqQ=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ═══════════════════════════════════════════════════════════════════════════
# KAVENEGAR SMS SERVICE
# ═══════════════════════════════════════════════════════════════════════════
KAVENEGAR_API_KEY=5242444B61426662376B665444496E4D723750586762796766766766724972664561756966396E574651593D
KAVENEGAR_TEMPLATE=weekilaw
# On server set false (real SMS). Local: true (OTP 12345, no SMS).
OTP_DEV_MODE=false
