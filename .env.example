# ═══════════════════════════════════════════════════════════════════════════
# SEP (SEPAHAN/SAMAN) PAYMENT GATEWAY CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
SEP_MERCHANT_ID=15328639
SEP_TERMINAL_ID=15328639

# Callback URL - Must be publicly accessible (registered in Saman merchant panel)
# This URL must be registered in your Saman merchant panel
SEP_CALLBACK_URL=https://weekilaw.com/api/payment/payment-listener

# Base URL for payment gateway redirects (must be publicly accessible)
SEP_BASE_URL=https://weekilaw.com

# Verify callback URL (must be publicly accessible)
SEP_VERIFY_URL=https://weekilaw.com/api/payment/verify-callback

# Web app URL for redirects after payment
SEP_WEB_APP_URL=https://weekilaw.com

# ═══════════════════════════════════════════════════════════════════════════
# MONGODB CONFIGURATION (shared with Node.js backend)
# ═══════════════════════════════════════════════════════════════════════════
# Format: mongodb://USER:PASSWORD@HOST:27017/?authSource=admin (use your real URI on server)
MONGODB_URI=mongodb://USER:PASSWORD@HOST:27017/?authSource=admin
MONGODB_DATABASE=test
MONGODB_COLLECTION=users

# ═══════════════════════════════════════════════════════════════════════════
# NOTES:
# 1. For PRODUCTION: Ensure callback URL (https://weekilaw.com/api/payment/payment-listener) is registered in SEP merchant panel
# 2. After changing .env, run: php artisan config:clear
# 3. Payment API base URL: https://weekilaw.com/api/payment
# ═══════════════════════════════════════════════════════════════════════════
